{
  "expo": {
    "name": "F5 Chat",
    "slug": "chat-app",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "chatapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Cho phép F5 Chat truy cập camera để thực hiện cuộc gọi video và gửi hình ảnh.",
        "NSMicrophoneUsageDescription": "Cho phép F5 Chat truy cập micro để thực hiện cuộc gọi thoại và video.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "bundleIdentifier": "com.chatapp"
    },
    "android": {
      "package": "com.chatapp",
      "versionCode": 3,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#050507"
      },
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS",
        "POST_NOTIFICATIONS",
        "VIBRATE",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-asset",
      "expo-audio",
      "expo-video",
      "@react-native-community/datetimepicker",
      "expo-font",
      "expo-localization",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icon.png",
          "backgroundColor": "#050507",
          "imageWidth": 200
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#6366f1",
          "sounds": [
            "./assets/sounds/notif_ding.wav",
            "./assets/sounds/notif_pop.wav",
            "./assets/sounds/notif_chime.wav",
            "./assets/sounds/notif_tri.wav"
          ]
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Cho phép F5 Chat truy cập camera để thực hiện cuộc gọi video và chụp ảnh.",
          "microphonePermission": "Cho phép F5 Chat truy cập micro để thực hiện cuộc gọi thoại và video.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": false,
            "enableShrinkResourcesInReleaseBuilds": false,
            "usesCleartextTraffic": true,
            "extraProguardRules": "-keep class com.swmansion.reanimated.** { *; }\n-keep class com.facebook.react.turbomodule.** { *; }\n-keep class io.agora.** { *; }\n-dontwarn io.agora.**\n-keep class expo.modules.** { *; }"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "owner": "phamhinhs-team",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2f0d207a-27bd-441f-9afc-f55fbcd38b6d"
      }
    }
  }
}
